/diagnose.result
/cache

# Ignore Python cache files
__pycache__/
*.py[cod]

/dots/.config/quickshell/ii/.qmlls.ini

# exp-update
/.update-lock

# custom os-release
/os-release

# Emacs auto backup file
*~

# Dead pre-lua Hyprland user overrides. `hyprland.lua` only sources
# `custom/*.lua`, so these linger in $HOME from older installs and carry no
# config. Not tracked, but not deleted either — `./fork deploy` leaves files
# that exist in the working tree alone.
/dots/.config/hypr/custom/*.conf

# NOTE: `/.claude/` and `/CLAUDE.md` are ignored on `main` but tracked on
# this branch. Do not re-add those ignores here, or personal Claude Code
# state and guidance will stop being versioned. If `.claude/` or
# `CLAUDE.md` show up in `git status` on this branch, that's intentional.

# ...with one exception: Claude Code puts its git worktrees here, which are whole
# checkouts of this repo. Since `/.claude/` is un-ignored above, without this a
# stray `git add .claude` would commit nested clones into the fork.
/.claude/worktrees/
